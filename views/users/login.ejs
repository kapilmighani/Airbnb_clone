<% layout("layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Login for Wanderlust</h1>
    <div class="col-6 offset-3">
        <form action="/login" method="post" class="needs-validation" novalidate>
            <div class="md-3">
                <label for="username" class="form-label">username</label>
                <input  class="form-control" id="username" type="text" name="username" id="title" required>
            </div>
            <div class="md-3">
                <label for="password" class="form-label">Password</label>
                <input  class="form-control" id="password" type="password" name="password" id="title" required>
            </div>
            <button class="btn btn-success">Login</button>
        </form>
    </div>
</div>        