<% layout("layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3">Signup for Wanderlust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="post" class="needs-validation" novalidate>
            <div class="md-3">
                <label for="username" class="form-label">username</label>
                <input  class="form-control" id="username" type="text" name="username" id="title" required>
                <div class="invalid-feedback">looks good!</div>
            </div>
            <div class="md-3">
                <label for="email" class="form-label">Email</label>
                <input  class="form-control" id="email" type="email" name="email" id="title" required>
            </div>
            <div class="md-3">
                <label for="password" class="form-label">Password</label>
                <input  class="form-control" id="password" type="password" name="password" id="title" required>
            </div>
            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>        